# Base Sepolia Deployment Configuration
# Copy to .env and fill in your values

# RPC URL for Base Sepolia (get from Alchemy, Infura, or similar)
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployer private key (WITHOUT 0x prefix)
DEPLOYER_KEY=your_private_key_here

# Deployer address (for verification)
DEPLOYER_ADDRESS=0xYourDeployerAddress

# Treasury address (receives fees)
TREASURY_ADDRESS=0xYourTreasuryAddress

# Validator pool address (optional, defaults to treasury)
VALIDATOR_POOL=0xYourValidatorPoolAddress

# Etherscan API key for verification
ETHERSCAN_API_KEY=your_etherscan_api_key